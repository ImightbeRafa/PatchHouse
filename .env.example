
TILOPAY_WEBHOOK_SECRET=your_tilopay_webhook_secret_here
TILOPAY_BASE_URL=https://app.tilopay.com/api/v1
TILOPAY_API_KEY=your_tilopay_api_key_here
TILOPAY_USER=your_tilopay_user_here
TILOPAY_PASSWORD=your_tilopay_password_here


RESEND_API_KEY=your_resend_api_key_here
ORDER_NOTIFICATION_EMAIL=your_email@example.com


APP_URL=https://patchhouse.shopping


BETSY_API_KEY=your_betsy_api_key_here
BETSY_API_URL=https://www.betsycrm.com/api/integration/orders/create


# Sold-out configuration (comma-separated product keys: focus, nad, energy, glp1, dopamine, stress)
# Sold-out singles are disabled. Static combos with sold-out patches are disabled.
# Full House automatically rebuilds itself from in-stock patches that are not combo-excluded.
VITE_SOLD_OUT=
VITE_SOLD_OUT_MESSAGE=¡Vuelve pronto! Llega en 10 días

# Products that remain available as singles but should not appear in combos.
# Remove "nad" later if NAD returns to combos.
VITE_COMBO_EXCLUDED=nad

# Optional Full House price overrides by active patch count.
# VITE_FULL_HOUSE_PRICE_5=44900
