# ── Site ─────────────────────────────────────────────────────────────
APP_URL=https://patchhouse.shopping

# ── SINPE Móvil ──────────────────────────────────────────────────────
# Shown to the customer after they place a SINPE order. BOTH are required:
# if either is missing, SINPE Móvil is hidden at checkout.
SINPE_PHONE=88888888
SINPE_HOLDER=Nombre de quien recibe el SINPE

# ── Tilopay (card payments) ──────────────────────────────────────────
TILOPAY_BASE_URL=https://app.tilopay.com/api/v1
TILOPAY_API_KEY=your_tilopay_api_key_here
TILOPAY_USER=your_tilopay_user_here
TILOPAY_PASSWORD=your_tilopay_password_here
# Webhook (POST /api/tilopay/webhook) is where card orders are fulfilled.
TILOPAY_WEBHOOK_SECRET=your_tilopay_webhook_secret_here
# Optional: secret used to sign the order snapshot sent through Tilopay.
# Defaults to TILOPAY_WEBHOOK_SECRET. Changing it invalidates in-flight payments.
# ORDER_SIGNING_SECRET=
# WARNING: Tilopay also returns our signed returnData on DECLINED payments, so a customer can
# change code=0 to code=1 in the return URL. Signature proves the order is ours, not that it was paid.
# Approved card returns are fulfilled when our signed returnData verifies (code=1).
# Tilopay OrderHash is diagnostic only. TILOPAY_REDIRECT_FULFILL is ignored.

# ── Anti-troll: Cloudflare Turnstile (optional) ──────────────────────
# Both must be set to enable it; if either is missing the check is skipped and checkout works as before.
# NOT VITE_-prefixed: the server gives the public site key to the browser at runtime via /api/config.
# Outages fail open (orders go through). See shared/anti-troll/README.md.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# Optional: "off" skips the email MX lookup (syntax + disposable checks still run).
# ORDER_CHECKS_DNS=

# ── Email (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
ORDER_NOTIFICATION_EMAIL=your_email@example.com

# ── CRM (Betsy) ──────────────────────────────────────────────────────
BETSY_API_KEY=your_betsy_api_key_here
BETSY_API_URL=https://www.betsycrm.com/api/integration/orders/create

# ── Meta Conversions API ─────────────────────────────────────────────
META_CAPI_ACCESS_TOKEN=your_meta_capi_token_here
# Optional: Events Manager > Test events code (e.g. TEST12345). Remove after testing.
META_TEST_EVENT_CODE=

# ── Sandbox ──────────────────────────────────────────────────────────
# "true" = no emails, CRM sync, Meta events or Tilopay calls (orders just succeed).
# `npm run dev` turns this on automatically; never set it in production.
# ORDER_DRY_RUN=true

# ── Stock (read at build time by the pages AND at runtime by the API) ─
# Comma-separated product keys: focus, nad, energy, glp1, dopamine, stress
# Sold-out singles are disabled; combos containing them are disabled too.
# Full House rebuilds itself from in-stock patches that are not combo-excluded.
VITE_SOLD_OUT=
VITE_SOLD_OUT_MESSAGE=¡Vuelve pronto! Llega en 10 días

# Patches sold as singles only (not offered in combos / Full House).
VITE_COMBO_EXCLUDED=nad

# Optional Full House price overrides by number of patches included (2-6).
# VITE_FULL_HOUSE_PRICE_5=44900
